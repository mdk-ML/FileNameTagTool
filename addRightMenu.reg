Windows Registry Editor Version 5.00

; =========================
; 顶层：显示一个带子菜单的项（系统全局）
; =========================
[HKEY_CLASSES_ROOT\*\shell\TagMenu]
"MUIVerb"="文件标签"
"Icon"="C:\\Users\\MU\\Documents\\FileNameTagTool\\ico\\tags.ico"
"SubCommands"="TagMenu.newVersion;TagMenu.RemoveAll;TagMenu.copyWithoutTags;"
"MultiSelectModel"="Player"
"CommandTemplate"=""
"Position"="Top"

; =========================
; 子命令：移除所有标签（removeAll）
; =========================
[HKEY_LOCAL_MACHINE\SOFTWARE\Microsoft\Windows\CurrentVersion\Explorer\CommandStore\shell\TagMenu.RemoveAll]
"MUIVerb"="移除所有标签"
"Icon"="C:\\Users\\MU\\Documents\\FileNameTagTool\\ico\\removeAll.ico"

[HKEY_LOCAL_MACHINE\SOFTWARE\Microsoft\Windows\CurrentVersion\Explorer\CommandStore\shell\TagMenu.RemoveAll\command]
@="\"C:\\Program Files\\Java\\jdk-17\\bin\\javaw.exe\" -jar \"C:\\Users\\MU\\Documents\\FileNameTagTool\\target\\filename-tagtool-1.0.0.jar\" removeAll \"%L\""

; =========================
; 子命令：创建无标签副本 copyWithoutTags
; =========================
[HKEY_LOCAL_MACHINE\SOFTWARE\Microsoft\Windows\CurrentVersion\Explorer\CommandStore\shell\TagMenu.copyWithoutTags]
"MUIVerb"="创建无标签副本"
"Icon"="C:\\Users\\MU\\Documents\\FileNameTagTool\\ico\\copyWithoutTags.ico"

[HKEY_LOCAL_MACHINE\SOFTWARE\Microsoft\Windows\CurrentVersion\Explorer\CommandStore\shell\TagMenu.copyWithoutTags\command]
@="\"C:\\Program Files\\Java\\jdk-17\\bin\\javaw.exe\" -jar \"C:\\Users\\MU\\Documents\\FileNameTagTool\\target\\filename-tagtool-1.0.0.jar\" copyWithoutTags \"%L\""
; =========================
; 子命令：生成新版本 newVersion 
; =========================
[HKEY_LOCAL_MACHINE\SOFTWARE\Microsoft\Windows\CurrentVersion\Explorer\CommandStore\shell\TagMenu.newVersion]
"MUIVerb"="生成新版本"
"Icon"="C:\\Users\\MU\\Documents\\FileNameTagTool\\ico\\newVersion.ico"

[HKEY_LOCAL_MACHINE\SOFTWARE\Microsoft\Windows\CurrentVersion\Explorer\CommandStore\shell\TagMenu.newVersion\command]
@="\"C:\\Program Files\\Java\\jdk-17\\bin\\javaw.exe\" -jar \"C:\\Users\\MU\\Documents\\FileNameTagTool\\target\\filename-tagtool-1.0.0.jar\" newVersion \"%L\""

; =========================
; 目录背景右键菜单：文件标签
; =========================
[HKEY_CLASSES_ROOT\Directory\Background\shell\TagMenu.ManageTags]
"MUIVerb"="管理此目录的文件标签"
"Icon"="C:\\Users\\MU\\Documents\\FileNameTagTool\\ico\\tags.ico"
"Position"="Top"

[HKEY_CLASSES_ROOT\Directory\Background\shell\TagMenu.ManageTags\command]
@="\"C:\\Program Files\\Java\\jdk-17\\bin\\javaw.exe\" -jar \"C:\\Users\\MU\\Documents\\FileNameTagTool\\target\\filename-tagtool-1.0.0.jar\" manage \"%V\""

; =========================
; 目录对象右键菜单：文件标签
; =========================
[HKEY_CLASSES_ROOT\Directory\shell\TagMenu.ManageTags]
"MUIVerb"="管理当前目录的文件标签"
"Icon"="C:\\Users\\MU\\Documents\\FileNameTagTool\\ico\\tags.ico"
"Position"="Top"

[HKEY_CLASSES_ROOT\Directory\shell\TagMenu.ManageTags\command]
@="\"C:\\Program Files\\Java\\jdk-17\\bin\\javaw.exe\" -jar \"C:\\Users\\MU\\Documents\\FileNameTagTool\\target\\filename-tagtool-1.0.0.jar\" manage \"%L\""